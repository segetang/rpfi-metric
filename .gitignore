# ---- Raw data (never commit; obtain separately per §3 of README) ----
data/
*.mp4
*.avi

# ---- Training runs / model weights / predictions (large binary artifacts) ----
runs/
*.pth
*.pt
*.ckpt

# Predictions and intermediate npy arrays produced by the pipeline
# (keep small hand-curated example arrays under docs/ if needed, everything
#  else is regenerable via the pipeline commands in README §4)
*_test_pred.npy
*_prediction.npy
*_label.npy

# ---- Result / report directories (regenerable from runs/) ----
results_*_final/
results_cross_*/
result_log/
anchors_v*/
gallery/
hp_sens_*/
lag_template_*/
prv_agreement_*/
ranking_validation/
sqi_comparison_report/
physdiff_asymmetry_report/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
build/
dist/

# ---- Environments ----
.venv/
venv/
env/
.conda/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Logs ----
*.log
logs/

# ---- Large figures (keep only final curated figures under docs/figures) ----
*.png
*.jpg
*.jpeg
!docs/figures/*.png
!docs/figures/*.jpg
